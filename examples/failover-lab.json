{
  "format_version": 2,
  "id": "failover-lab",
  "revision": "1",
  "devices": [
    { "kind": "host", "id": "pc-a", "name": "PC-A", "ipv4": "192.0.2.10", "prefix_length": 24,
      "mac": "02:00:00:00:00:0a", "port": { "id": "pc-a-eth0", "name": "eth0" } },
    { "kind": "switch", "id": "sw1", "name": "SW1", "ports": [
      { "id": "sw1-access", "name": "G0/3", "mode": { "kind": "access", "vlan": 10 } },
      { "id": "sw1-primary", "name": "G0/1", "mode": { "kind": "trunk", "allowed_vlans": [10, 20] } },
      { "id": "sw1-standby", "name": "G0/2", "mode": { "kind": "trunk", "allowed_vlans": [10, 20] } }
    ] },
    { "kind": "switch", "id": "sw2", "name": "SW2", "ports": [
      { "id": "sw2-access", "name": "G0/3", "mode": { "kind": "access", "vlan": 10 } },
      { "id": "sw2-primary", "name": "G0/1", "mode": { "kind": "trunk", "allowed_vlans": [10, 20] } },
      { "id": "sw2-standby", "name": "G0/2", "mode": { "kind": "trunk", "allowed_vlans": [20] } }
    ] },
    { "kind": "host", "id": "pc-b", "name": "PC-B", "ipv4": "192.0.2.20", "prefix_length": 24,
      "mac": "02:00:00:00:00:0b", "port": { "id": "pc-b-eth0", "name": "eth0" } }
  ],
  "links": [
    { "id": "a-sw1", "ports": ["pc-a-eth0", "sw1-access"], "delay_ns": "100" },
    { "id": "inter-switch-primary", "ports": ["sw1-primary", "sw2-primary"], "delay_ns": "100" },
    { "id": "inter-switch-standby", "ports": ["sw1-standby", "sw2-standby"], "delay_ns": "200",
      "standby_for": "inter-switch-primary" },
    { "id": "sw2-b", "ports": ["sw2-access", "pc-b-eth0"], "delay_ns": "100" }
  ],
  "scenario": {
    "end_ns": "4700",
    "arp_lifetime_ns": "1000000000",
    "mac_lifetime_ns": "1000000000",
    "trace_limit": 0,
    "warmup": [{ "at_ns": "0", "port": "pc-a-eth0", "neighbor": "192.0.2.20" }],
    "link_actions": [
      { "link": "inter-switch-primary", "at_ns": "2200", "state": "down" },
      { "link": "inter-switch-primary", "at_ns": "3500", "state": "up" }
    ],
    "probes": [
      { "id": "before-failure", "source": "pc-a", "destination": "pc-b", "at_ns": "1000", "deadline_ns": "1800" },
      { "id": "in-flight", "source": "pc-a", "destination": "pc-b", "at_ns": "2000", "deadline_ns": "2450" },
      { "id": "on-standby", "source": "pc-a", "destination": "pc-b", "at_ns": "2500", "deadline_ns": "3400" },
      { "id": "after-recovery", "source": "pc-a", "destination": "pc-b", "at_ns": "3700", "deadline_ns": "4500" }
    ]
  }
}
